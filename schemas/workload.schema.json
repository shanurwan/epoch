{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epoch.local/schemas/workload.schema.json",
  "title": "Epoch trusted guest workload manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "id", "version", "uid", "gid", "working_dir", "environment", "actions", "services"],
  "properties": {
    "api_version": {"const": "epoch-workload/v1"},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "minLength": 1},
    "uid": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "gid": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "working_dir": {"type": "string", "pattern": "^/"},
    "environment": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "string", "maxLength": 4096}},
    "actions": {"type": "object", "minProperties": 1, "maxProperties": 128, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/command"}},
    "services": {"type": "object", "maxProperties": 4, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/service"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"},
    "argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "maxLength": 4096}},
    "command": {"type": "object", "additionalProperties": false, "required": ["argv"], "properties": {"argv": {"$ref": "#/$defs/argv"}}},
    "service": {"type": "object", "additionalProperties": false, "required": ["argv", "readiness_action"], "properties": {"argv": {"$ref": "#/$defs/argv"}, "readiness_action": {"$ref": "#/$defs/id"}}}
  }
}
