{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epoch.invalid/schemas/image.schema.json",
  "title": "Epoch prepared image manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "id",
    "architecture",
    "kernel",
    "rootfs",
    "firecracker_version",
    "guest_agent",
    "workload",
    "recipe"
  ],
  "properties": {
    "api_version": {
      "const": "epoch-image/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "architecture": {
      "const": "x86_64"
    },
    "kernel": {
      "$ref": "#/$defs/kernel"
    },
    "rootfs": {
      "$ref": "#/$defs/rootfs"
    },
    "firecracker_version": {
      "const": "1.16.1"
    },
    "guest_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "protocol_version",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "const": "epoch-guest/v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "manifest_path",
        "manifest_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "transformations"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "description": "Metadata identifies trusted local inputs and transformations. The full manifest is bounded to 32 KiB. A digest is content identity, not a signature or provenance proof. Epoch verifies actual sizes/hashes before launch; this schema cannot do so.",
  "$defs": {
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "source_identity",
        "checksum_origin"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "source_identity": {
          "type": "string",
          "minLength": 1
        },
        "checksum_origin": {
          "enum": [
            "locally-observed",
            "upstream-published"
          ]
        }
      }
    },
    "rootfs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "source_identity",
        "checksum_origin"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "source_identity": {
          "type": "string",
          "minLength": 1
        },
        "checksum_origin": {
          "enum": [
            "locally-observed",
            "upstream-published"
          ]
        }
      }
    }
  }
}
